<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI; this platform theme only sets the window colors before it does. -->
    <style name="Theme.ServerScope" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
